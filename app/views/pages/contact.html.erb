<% content_for :title, "Contact" %>

<main class="mx-auto grid w-full max-w-4xl gap-5 px-4 py-8 sm:px-6 lg:px-8">
  <section class="rounded-3xl border border-emerald-200/70 bg-gradient-to-br from-emerald-50 via-white to-amber-50 p-7 shadow-sm sm:p-9">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-700">Contact</p>
    <h1 class="mt-2 text-3xl font-black leading-tight text-slate-900 sm:text-4xl">Request a Training Session</h1>
    <p class="mt-3 text-sm text-slate-700 sm:text-base">
      Share your age group, skill level, and goals. Training is offered in Evergreen, Colorado; the exact location is shared with confirmed clients.
    </p>
  </section>

  <% if flash[:notice].present? %>
    <div class="rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700"><%= flash[:alert] %></div>
  <% end %>

  <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <% if business_email.present? || business_phone.present? %>
      <div class="mb-5 rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
        <p class="font-semibold text-slate-900">Direct contact</p>
        <% if business_email.present? %>
          <p class="mt-1">Email: <%= mail_to business_email, business_email, class: "font-medium text-emerald-700 hover:text-emerald-800" %></p>
        <% end %>
        <% if business_phone.present? %>
          <p class="mt-1">Phone: <%= link_to business_phone, "tel:#{business_phone.gsub(/[^+\d]/, '')}", class: "font-medium text-emerald-700 hover:text-emerald-800" %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @contact_message, url: contact_path, class: "grid gap-4" do |form| %>
      <%= form.hidden_field :training_session_id %>
      <div class="hidden" aria-hidden="true">
        <%= form.label :website, "Website" %>
        <%= form.text_field :website, tabindex: -1, autocomplete: "off" %>
      </div>

      <% if @selected_session.present? %>
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
          <p class="text-xs font-bold uppercase tracking-wide"><%= @selected_session.full? ? "Waitlist request" : "Selected session" %></p>
          <p class="mt-1 font-bold"><%= @selected_session.title %></p>
          <p class="mt-1"><%= @selected_session.starts_at.strftime("%A, %B %-d at %-I:%M %p") %></p>
          <% if @selected_session.full? %>
            <p class="mt-2 font-medium">This session is full. Submit the form to join its waitlist.</p>
          <% else %>
            <p class="mt-2"><%= pluralize(@selected_session.spots_remaining, "spot") %> currently available.</p>
          <% end %>
        </div>
      <% end %>

      <% if @contact_message.errors.any? %>
        <div class="rounded-xl border border-rose-300 bg-rose-50 p-3 text-sm text-rose-700">
          <p class="font-semibold">Please fix the fields below:</p>
          <ul class="mt-1 list-disc pl-5">
            <% @contact_message.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :name, class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.text_field :name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>

        <div>
          <%= form.label :email, class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.email_field :email, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>

        <div>
          <%= form.label :phone, class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.telephone_field :phone, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>

        <div>
          <%= form.label :age_group, class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.select :age_group, @age_group_options, { prompt: "Select age group" }, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>

        <div>
          <%= form.label :guardian_name, "Parent or guardian name", class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.text_field :guardian_name, placeholder: "Required for junior and teen requests", class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>

        <div class="sm:col-span-2">
          <%= form.label :skill_level, class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.select :skill_level, @skill_level_options, { prompt: "Select skill level" }, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>

        <div class="sm:col-span-2">
          <%= form.label :goals, "Primary goals", class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.text_field :goals, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>

        <div class="sm:col-span-2">
          <%= form.label :message, class: "mb-1 block text-sm font-semibold text-slate-700" %>
          <%= form.text_area :message, rows: 5, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-emerald-500 focus:outline-none" %>
        </div>
      </div>

      <label class="flex items-start gap-2 text-sm leading-relaxed text-slate-600">
        <%= form.check_box :policy_accepted, class: "mt-1 rounded border-slate-300 text-emerald-700 focus:ring-emerald-500" %>
        <span>I am 18 or older and agree to the <%= link_to "booking, privacy, and youth-training policies", policies_path, class: "font-medium text-emerald-700 hover:text-emerald-800", target: "_blank", rel: "noopener" %>. If this request is for a minor, I am their parent or legal guardian.</span>
      </label>

      <div>
        <%= form.submit "Send Request", class: "inline-flex items-center rounded-full bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800" %>
        <p class="mt-3 max-w-2xl text-xs leading-relaxed text-slate-500">Submitting this form is an inquiry, not a confirmed booking. Availability, location, price, and payment details will be confirmed directly before a session is scheduled. Your information is used to respond to and manage your request. See the <%= link_to "privacy and booking policies", policies_path, class: "font-medium text-emerald-700 hover:text-emerald-800" %>.</p>
      </div>
    <% end %>
  </section>
</main>
